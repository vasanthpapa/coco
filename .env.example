# MongoDB Atlas (required locally and on Vercel). Never commit real credentials.
# URL-encode special characters in the password: @ becomes %40.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=coco

# Required for AI analysis.
GEMINI_API_KEY=

# Only for the optional one-time SQLite-to-MongoDB migration (Node.js 24+).
# SQLITE_DATABASE_PATH=data/coco.db
